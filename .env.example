# ============================================================
# Loyola AI Assistant - Environment Configuration Template
# ============================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Add your Groq or Gemini API key below.
# 3. Start the app via `npm start` or `node server.js`.
# ============================================================

# AI Provider: 'openai' (for Groq / OpenAI), 'gemini', or 'offline'
API_PROVIDER=openai

# Your AI API Key:
# - Groq API Key (Recommended for ultra-fast speed): https://console.groq.com/keys
# - Google Gemini API Key: https://aistudio.google.com/
# Leave empty to run 100% offline using the built-in Loyola Knowledge Base!
API_KEY=your_api_key_here

# Model Configurations
OPENAI_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.0-flash

# Endpoints
OPENAI_API_URL=https://api.groq.com/openai/v1/chat/completions
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# Server Port (optional, default: 3000)
PORT=3000
